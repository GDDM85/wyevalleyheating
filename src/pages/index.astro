---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import AreasCovered from '../components/AreasCovered.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';

const meta = {
  title: `${business.name} — Heating, Plumbing & Renewables`,
  description: `${business.name}, covering ${business.areaSummary}. Gas Safe registered, MCS certified renewables installer.`,
};
---
<Layout title={meta.title} description={meta.description}>
  <Header />
  <Hero />
  <TrustStrip />
  <About />
  <Services />
  <Gallery />
  <Testimonials />
  <AreasCovered />
  <Contact />
  <Footer />
</Layout>
