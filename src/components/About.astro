---
import { aboutHighlights, aboutCallout, aboutImage } from '../data/business';
import { imageExists } from '../utils/checkImage';

const hasAboutImage = imageExists(aboutImage.path);
---
<section id="about" class="bg-slate-50 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="space-y-6">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-leaf-600">About Us</p>
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Your Local Plumbing, Heating &amp; Renewables Engineer</h2>
        <p class="leading-8 text-slate-600">
          With years of experience in the plumbing, heating and renewables industry, I take pride in delivering reliable, honest and high quality workmanship on every job.
        </p>
        <ul class="space-y-3">
          {aboutHighlights.map((point) => (
            <li class="flex items-start gap-3 text-slate-700">
              <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-flame-500/10 text-flame-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
        <a href="#contact" class="inline-flex items-center justify-center rounded-md border border-leaf-600 px-6 py-3 text-sm font-semibold text-leaf-700 hover:bg-leaf-50">
          Learn More About Me
        </a>
      </div>

      <div class="relative">
        {hasAboutImage ? (
          <img src={aboutImage.path} alt={aboutImage.alt} class="w-full rounded-xl object-cover shadow-xl" />
        ) : (
          <div class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-slate-300 bg-white p-8 text-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-12 w-12"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            <p class="text-sm font-semibold">Add a work photo here</p>
            <p class="text-xs">public{aboutImage.path}</p>
          </div>
        )}

        <div class="absolute -bottom-6 -right-4 max-w-xs rounded-xl bg-navy-900 p-5 shadow-2xl sm:right-4">
          <p class="text-sm font-bold text-white">{aboutCallout.title}</p>
          <p class="mt-1 text-xs leading-5 text-slate-300">{aboutCallout.description}</p>
          <a href="#services" class="mt-3 inline-block text-xs font-semibold uppercase tracking-wide text-leaf-400 hover:text-leaf-300">
            {aboutCallout.linkLabel} →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
