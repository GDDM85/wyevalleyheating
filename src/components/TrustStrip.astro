---
import { trustStrip } from '../data/business';
import { imageExists } from '../utils/checkImage';
---
<section class="bg-white py-14">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 text-center sm:grid-cols-2 lg:grid-cols-4">
    {trustStrip.map((item) => (
      <div class="flex flex-col items-center gap-3">
        {item.logo && imageExists(item.logo) ? (
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-slate-100 bg-white p-2 shadow-sm">
            <img src={item.logo} alt={`${item.title} logo`} class="h-full w-full object-contain" />
          </span>
        ) : (
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full border-2 border-flame-500 text-flame-600">
            <span class="h-6 w-6" set:html={item.icon}></span>
          </span>
        )}
        <h3 class="text-sm font-semibold text-slate-900">{item.title}</h3>
        <p class="text-xs leading-5 text-slate-500">{item.description}</p>
      </div>
    ))}
  </div>
</section>
