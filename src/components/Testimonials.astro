---
import { testimonials } from '../data/business';
---
<section id="reviews" class="bg-slate-50 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl space-y-3 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-leaf-600">What Our Customers Say</p>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">5 Star Rated Service</h2>
      <p class="text-xs text-slate-400">Sample reviews shown for demonstration purposes.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {testimonials.map((testimonial) => (
        <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
          <div class="mb-4 flex gap-1 text-amber-400">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            ))}
          </div>
          <p class="leading-7 text-slate-600">&ldquo;{testimonial.quote}&rdquo;</p>
          <p class="mt-4 text-sm font-semibold text-slate-900">{testimonial.author}</p>
          <p class="text-xs text-slate-400">{testimonial.location}</p>
        </div>
      ))}
    </div>
  </div>
</section>
