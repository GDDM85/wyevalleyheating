---
import { getGalleryImages } from '../utils/gallery';

const items = getGalleryImages('/images/gallery');
---
<section id="projects" class="bg-white py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl space-y-3 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-leaf-600">Recent Projects</p>
      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">A few jobs from around the area.</h2>
    </div>

    {items.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {items.map((item, index) => (
          <button
            type="button"
            class="group aspect-square w-full overflow-hidden rounded-2xl shadow-md"
            data-gallery-trigger
            data-index={index}
            aria-label={`View larger photo: ${item.alt}`}
          >
            <img
              src={item.path}
              alt={item.alt}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </button>
        ))}
      </div>
    ) : (
      <div class="mt-12 flex aspect-[3/1] w-full flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
        <p class="text-xs font-medium">Add project photos to public/images/gallery/ to fill this section</p>
      </div>
    )}
  </div>

  <dialog id="gallery-lightbox" class="max-w-4xl rounded-2xl bg-transparent p-0 backdrop:bg-navy-950/90">
    <div class="relative">
      <button
        type="button"
        data-gallery-close
        aria-label="Close"
        class="absolute -top-11 right-0 rounded-full bg-black/40 p-2 text-white hover:bg-black/60"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
      <img data-gallery-image src="" alt="" class="max-h-[80vh] w-full rounded-xl object-contain" />
      <button
        type="button"
        data-gallery-prev
        aria-label="Previous photo"
        class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-2 text-white hover:bg-black/60"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <button
        type="button"
        data-gallery-next
        aria-label="Next photo"
        class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-2 text-white hover:bg-black/60"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
    </div>
  </dialog>
</section>

<script define:vars={{ items }}>
  const dialog = document.getElementById('gallery-lightbox');
  const imageEl = dialog?.querySelector('[data-gallery-image]');
  let currentIndex = 0;

  function show(index) {
    if (!imageEl || items.length === 0) return;
    currentIndex = (index + items.length) % items.length;
    imageEl.src = items[currentIndex].path;
    imageEl.alt = items[currentIndex].alt;
  }

  document.querySelectorAll('[data-gallery-trigger]').forEach((button) => {
    button.addEventListener('click', () => {
      show(Number(button.dataset.index));
      dialog?.showModal();
    });
  });

  dialog?.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(currentIndex - 1));
  dialog?.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(currentIndex + 1));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(currentIndex - 1);
    if (event.key === 'ArrowRight') show(currentIndex + 1);
  });
</script>
