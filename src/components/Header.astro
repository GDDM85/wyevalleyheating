---
import { business, navItems, logoIcon } from '../data/business';
---
<header class="sticky top-0 z-30 bg-navy-900">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="#home" class="flex items-center gap-3">
      <img src={logoIcon} alt="" class="h-10 w-10 flex-shrink-0" />
      <span class="leading-tight">
        <span class="block text-base font-extrabold tracking-wide text-white">{business.logoPrimary}</span>
        <span class="block text-[11px] font-semibold uppercase tracking-[0.15em] text-leaf-400">{business.logoTagline}</span>
      </span>
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-6 text-sm font-medium text-slate-300 lg:flex">
      {navItems.map((item) => (
        <a href={`#${item.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-leaf-400">{item}</a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a href={business.phoneHref} class="hidden items-center gap-2 text-white sm:inline-flex">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-flame-400"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span class="leading-tight">
          <span class="block text-sm font-semibold">{business.phone}</span>
          <span class="block text-[11px] text-slate-400">Call for a free quote</span>
        </span>
      </a>

      <button
        id="tradie-menu-btn"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 text-white lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="tradie-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="tradie-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="tradie-mobile-menu" class="hidden border-t border-white/10 bg-navy-900 px-6 py-4 lg:hidden">
    <div class="flex flex-col gap-4 text-sm font-medium text-slate-300">
      {navItems.map((item) => (
        <a href={`#${item.toLowerCase().replace(/\s+/g, '-')}`} class="py-1 hover:text-leaf-400 tradie-mobile-nav-link">{item}</a>
      ))}
      <a href={business.phoneHref} class="mt-2 inline-flex items-center justify-center rounded-full bg-leaf-600 px-5 py-2.5 text-sm font-semibold text-white">
        Call {business.phone}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('tradie-menu-btn');
  const menu = document.getElementById('tradie-mobile-menu');
  const iconOpen = document.getElementById('tradie-icon-open');
  const iconClose = document.getElementById('tradie-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn?.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.tradie-mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
