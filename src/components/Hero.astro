---
import { business, heroChecklist, heroImage, gasSafeLogo, altoLogo } from '../data/business';
import { imageExists } from '../utils/checkImage';

const hasHeroImage = imageExists(heroImage.path);
const hasAltoLogo = imageExists(altoLogo);

// Force the slogan onto two fixed lines rather than letting it wrap arbitrarily.
const sloganFinalPhrase = 'Greener Energy.';
const sloganLead = business.slogan.replace(sloganFinalPhrase, '').trim();
---
<section id="home" class="relative overflow-hidden bg-navy-900">
  {hasHeroImage && (
    <img src={heroImage.path} alt={heroImage.alt} class="absolute inset-0 h-full w-full object-cover" />
  )}
  <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-950/80 to-navy-950/40"></div>

  <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="max-w-2xl space-y-6">
      <h1 class="flex items-start gap-3 text-4xl font-extrabold leading-tight text-leaf-500 sm:text-5xl">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-9 w-9 flex-shrink-0 text-leaf-400/70 sm:mt-2 sm:h-11 sm:w-11"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
        <span>
          <span class="block">{sloganLead}</span>
          <span class="block">{sloganFinalPhrase}</span>
        </span>
      </h1>
      <p class="max-w-lg text-lg leading-8 text-slate-300">{business.intro}</p>

      <div class="grid gap-3 sm:grid-cols-2">
        {heroChecklist.map((item) => (
          <div class="inline-flex items-center gap-2 text-sm font-medium text-slate-200">
            <span class="inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-leaf-600 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap gap-4 pt-2">
        <a href={business.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-md bg-flame-600 px-6 py-3 text-sm font-semibold text-white hover:bg-flame-500">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Call Now
        </a>
        <a href="#contact" class="inline-flex items-center justify-center rounded-md border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:border-white/60">
          Request a Quote
        </a>
      </div>
    </div>

    {!hasHeroImage && (
      <p class="mt-10 inline-block rounded-md border border-dashed border-white/20 px-4 py-2 text-xs text-slate-400">
        Add a hero photo at public{heroImage.path}
      </p>
    )}
  </div>

  <div class="relative mx-6 mb-6 flex flex-wrap items-end justify-end gap-3 sm:mx-10 sm:mb-8">
    <div class="inline-flex items-center gap-3 rounded-lg bg-white px-4 py-2 shadow-lg">
      <img src={gasSafeLogo} alt="Gas Safe Register logo" class="h-9 w-auto flex-shrink-0" />
      <span class="leading-tight text-slate-900">
        <span class="block text-xs font-extrabold uppercase tracking-wide">Gas Safe Registered</span>
        <span class="block text-[11px] font-medium text-slate-500">No. {business.gasSafeNumber}</span>
      </span>
    </div>
    {hasAltoLogo && (
      <img
        src={altoLogo}
        alt="Alto Assured Partner Installer — MCS registered"
        class="h-14 w-14 flex-shrink-0 rounded-lg object-cover shadow-lg"
      />
    )}
  </div>
</section>
